{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker image:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker rm:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",

      "Bash(make:*)",
      "Bash(pytest:*)",
      "Bash(python3:*)",
      "Bash(hadolint:*)",
      "Bash(yamllint:*)",
      "Bash(shellcheck:*)",
      "Bash(codespell:*)",
      "Bash(gitleaks:*)",
      "Bash(trivy:*)",
      "Bash(pre-commit:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh release:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(cmp:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin/main:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf .git:*)",
      "Bash(sudo:*)"
    ]
  }
}
